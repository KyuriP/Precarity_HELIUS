\newlabel{fig-pc_sum-1}{{13a}{48}{Using both GaussianCI and RCoT}{figure.caption.19}{}}
\newlabel{sub@fig-pc_sum-1}{{a}{48}{Using both GaussianCI and RCoT}{figure.caption.19}{}}
\newlabel{fig-pc_sum-2}{{13b}{48}{Using only RCoT}{figure.caption.19}{}}
\newlabel{sub@fig-pc_sum-2}{{b}{48}{Using only RCoT}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {\emph  {Causal pathways between precariousness factors and overall depression severity, estimated with PC.}} \textbf  {(a)} Graph using both Gaussian CI and RCoT tests. \textbf  {(b)} Graph using only RCoT. PC produces a CPDAG, which excludes cycles and represents uncertainty with bidirectional edges. Gaussian CI yields denser graphs than RCoT.}}{48}{figure.caption.19}\protected@file@percent }
\newlabel{fig-pc_sum}{{13}{48}{\textbf {\emph {Causal pathways between precariousness factors and overall depression severity, estimated with PC.}} \textbf {(a)} Graph using both Gaussian CI and RCoT tests. \textbf {(b)} Graph using only RCoT. PC produces a CPDAG, which excludes cycles and represents uncertainty with bidirectional edges. Gaussian CI yields denser graphs than RCoT}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {\emph  {Causal pathways linking individual depressive symptoms and precariousness factors, estimated with PC.}} The CPDAG representation is denser than FCI or CCI outputs. Gaussian CI again produces more edges than RCoT (dashed navy edges mark those unique to Gaussian).}}{49}{figure.caption.20}\protected@file@percent }
\newlabel{fig-pc_sym}{{14}{49}{\textbf {\emph {Causal pathways linking individual depressive symptoms and precariousness factors, estimated with PC.}} The CPDAG representation is denser than FCI or CCI outputs. Gaussian CI again produces more edges than RCoT (dashed navy edges mark those unique to Gaussian)}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {\emph  {Causal pathways between overall precariousness and individual depressive symptoms, estimated with PC.}} As with the symptom-level graph, PC recovers dense structures under Gaussian CI but sparser ones under RCoT (dashed navy edges mark those unique to Gaussian).}}{49}{figure.caption.21}\protected@file@percent }
\newlabel{fig-pc_presum}{{15}{49}{\textbf {\emph {Causal pathways between overall precariousness and individual depressive symptoms, estimated with PC.}} As with the symptom-level graph, PC recovers dense structures under Gaussian CI but sparser ones under RCoT (dashed navy edges mark those unique to Gaussian)}{figure.caption.21}{}}
