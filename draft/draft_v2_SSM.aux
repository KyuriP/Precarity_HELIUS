\BKM@entry{id=14,dest={73756273756273656374696F6E2E332E312E32},srcline={1037}}{}
\newlabel{fig-sum-1}{{5a}{14}{FCI PAG}{figure.caption.8}{}}
\newlabel{sub@fig-sum-1}{{a}{14}{FCI PAG}{figure.caption.8}{}}
\newlabel{fig-sum-2}{{5b}{14}{Proportion matrix}{figure.caption.8}{}}
\newlabel{sub@fig-sum-2}{{b}{14}{Proportion matrix}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {\emph  {Causal pathways between precariousness factors and overall depression severity.}} Analysis with the FCI algorithm indicates that financial stress (\emph  {S.fin}) is the most consistent upstream influence on depression severity (\emph  {PHQsum}), while other forms of precariousness show weaker or more ambiguous connections. \textbf  {(a)} Aggregated causal graph showing the most frequent edge types across bootstraps. The edge pattern highlights \emph  {S.fin} as a plausible driver of depression, whereas employment and social precariousness are more often positioned downstream. Dashed edges indicate ties, with a bold horizontal bar marking where the tie occurs. \textbf  {(b)} Proportion matrix summarizing edge types across all bootstraps: each matrix cell \([i, j]\) indicates how often a given edge from variable \(i\) to variable \(j\) exhibited a particular edge mark (e.g., arrowhead, tail, or circle) adjacent to \(j\). Green indicates arrowheads, coral arrowtails, blue circle marks, and gray absence of an edge. Colors are blended and shaded by frequency, with dominant symbols appearing more opaque. For example, matrix{[}\(\mathit  {S.fin}\), \(\mathit  {PHQsum}\){]} shows a green arrowhead (\(>\)) and matrix{[}\(\mathit  {PHQsum}\), \(\mathit  {S.fin}\){]} shows a coral arrowtail (\textemdash ), together indicating that \(\mathit  {S.fin} \rightarrow \mathit  {PHQsum}\) in the majority of bootstrapped graphs.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig-sum}{{5}{14}{\textbf {\emph {Causal pathways between precariousness factors and overall depression severity.}} Analysis with the FCI algorithm indicates that financial stress (\emph {S.fin}) is the most consistent upstream influence on depression severity (\emph {PHQsum}), while other forms of precariousness show weaker or more ambiguous connections. \textbf {(a)} Aggregated causal graph showing the most frequent edge types across bootstraps. The edge pattern highlights \emph {S.fin} as a plausible driver of depression, whereas employment and social precariousness are more often positioned downstream. Dashed edges indicate ties, with a bold horizontal bar marking where the tie occurs. \textbf {(b)} Proportion matrix summarizing edge types across all bootstraps: each matrix cell \([i, j]\) indicates how often a given edge from variable \(i\) to variable \(j\) exhibited a particular edge mark (e.g., arrowhead, tail, or circle) adjacent to \(j\). Green indicates arrowheads, coral arrowtails, blue circle marks, and gray absence of an edge. Colors are blended and shaded by frequency, with dominant symbols appearing more opaque. For example, matrix{[}\(\mathit {S.fin}\), \(\mathit {PHQsum}\){]} shows a green arrowhead (\(>\)) and matrix{[}\(\mathit {PHQsum}\), \(\mathit {S.fin}\){]} shows a coral arrowtail (\textemdash ), together indicating that \(\mathit {S.fin} \rightarrow \mathit {PHQsum}\) in the majority of bootstrapped graphs}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.2}Individual depression symptom}{14}{subsubsection.3.1.2}\protected@file@percent }
\newlabel{individual-depression-symptom}{{3.1.2}{14}{Individual depression symptom}{subsubsection.3.1.2}{}}
\newlabel{fig-sym-1}{{6a}{17}{FCI PAG}{figure.caption.9}{}}
\newlabel{sub@fig-sym-1}{{a}{17}{FCI PAG}{figure.caption.9}{}}
\newlabel{fig-sym-2}{{6b}{17}{Proportion matrix}{figure.caption.9}{}}
\newlabel{sub@fig-sym-2}{{b}{17}{Proportion matrix}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {\emph  {Causal pathways linking individual depressive symptoms and precariousness factors.}} \textbf  {(a)} Aggregated FCI graph summarizing the most frequent edge types across bootstraps. The pattern suggests that depressed mood (\emph  {dep}), guilt (\emph  {glt}), and anhedonia (\emph  {anh}) often direct influence into social precariousness (\emph  {P.soc}), indicating that \emph  {P.soc} is more likely a consequence of core depressive symptoms than their cause. Sleep disturbance (\emph  {slp}) emerges as central within the broader network, with strong ties to several precariousness factors. Housing precariousness (\emph  {P.hou}) remains largely disconnected from symptoms, instead linking to employment and financial stress. \textbf  {(b)} Proportion matrix showing edge-type frequencies across bootstraps. Arrowheads are the most frequent endpoint overall, while circle marks---reflecting uncertainty or latent confounding---are particularly common for \emph  {slp}, \emph  {anh}, \emph  {ene}, and \emph  {sui}.}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig-sym}{{6}{17}{\textbf {\emph {Causal pathways linking individual depressive symptoms and precariousness factors.}} \textbf {(a)} Aggregated FCI graph summarizing the most frequent edge types across bootstraps. The pattern suggests that depressed mood (\emph {dep}), guilt (\emph {glt}), and anhedonia (\emph {anh}) often direct influence into social precariousness (\emph {P.soc}), indicating that \emph {P.soc} is more likely a consequence of core depressive symptoms than their cause. Sleep disturbance (\emph {slp}) emerges as central within the broader network, with strong ties to several precariousness factors. Housing precariousness (\emph {P.hou}) remains largely disconnected from symptoms, instead linking to employment and financial stress. \textbf {(b)} Proportion matrix showing edge-type frequencies across bootstraps. Arrowheads are the most frequent endpoint overall, while circle marks---reflecting uncertainty or latent confounding---are particularly common for \emph {slp}, \emph {anh}, \emph {ene}, and \emph {sui}}{figure.caption.9}{}}
\BKM@entry{id=15,dest={73756273756273656374696F6E2E332E312E33},srcline={1177}}{}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.3}Precariousness as sum score}{18}{subsubsection.3.1.3}\protected@file@percent }
\newlabel{precariousness-as-sum-score}{{3.1.3}{18}{Precariousness as sum score}{subsubsection.3.1.3}{}}
\newlabel{fig-presum-1}{{7a}{20}{FCI PAG}{figure.caption.10}{}}
\newlabel{sub@fig-presum-1}{{a}{20}{FCI PAG}{figure.caption.10}{}}
\newlabel{fig-presum-2}{{7b}{20}{Proportion matrix}{figure.caption.10}{}}
\newlabel{sub@fig-presum-2}{{b}{20}{Proportion matrix}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {\emph  {Causal pathways between overall precariousness and individual depressive symptoms.}} \textbf  {(a)} Aggregated FCI graph summarizing the most frequent edge types across bootstraps. The edge pattern indicates that depressive symptoms---particularly anhedonia (\emph  {anh}), depressed mood (\emph  {dep}), and sleep disturbance (\emph  {slp})---more often direct influence into overall precariousness, rather than the reverse. By contrast, symptoms such as appetite (\emph  {app}), guilt (\emph  {glt}), and motor disturbance (\emph  {mot}) show greater uncertainty in directionality. \textbf  {(b)} Proportion matrix showing edge-type frequencies across bootstraps. Symptom-to-symptom connections converge strongly on single edge types, with most interactions either bidirectional or split between arrowhead and circle marks, consistent with the presence of latent confounders.}}{20}{figure.caption.10}\protected@file@percent }
\newlabel{fig-presum}{{7}{20}{\textbf {\emph {Causal pathways between overall precariousness and individual depressive symptoms.}} \textbf {(a)} Aggregated FCI graph summarizing the most frequent edge types across bootstraps. The edge pattern indicates that depressive symptoms---particularly anhedonia (\emph {anh}), depressed mood (\emph {dep}), and sleep disturbance (\emph {slp})---more often direct influence into overall precariousness, rather than the reverse. By contrast, symptoms such as appetite (\emph {app}), guilt (\emph {glt}), and motor disturbance (\emph {mot}) show greater uncertainty in directionality. \textbf {(b)} Proportion matrix showing edge-type frequencies across bootstraps. Symptom-to-symptom connections converge strongly on single edge types, with most interactions either bidirectional or split between arrowhead and circle marks, consistent with the presence of latent confounders}{figure.caption.10}{}}
\BKM@entry{id=16,dest={73756273656374696F6E2E332E32},srcline={1292}}{}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Simulating the Dynamics Between Precariousness and Depression Under Intervention}{21}{subsection.3.2}\protected@file@percent }
\newlabel{simulating-the-dynamics-between-precariousness-and-depression-under-intervention}{{3.2}{21}{Simulating the Dynamics Between Precariousness and Depression Under Intervention}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {\emph  {System response to external intervention across variations in internal structure.}} \textbf  {(A)} \emph  {Mean levels of depression (\(D\)) and precariousness (\(P\)) at key time points.} At time steps 100, 300, and 500, we compare models that differ in the coupling coefficient \(\alpha _{DP}\), which represents the strength of depression's influence on precariousness in the dynamical model. The x‑axis shows intervention strength, defined as the proportional reduction of financial stress (\(S\)) relative to its baseline (with higher values indicating more external financial support). Each line corresponds to a different model, color-coded from weak (purple) to strong (yellow) coupling. Models with weaker coupling exhibit faster early reductions in \(D\), while stronger coupling shifts the response toward \(P\), producing more immediate declines in precariousness. \textbf  {(B)} \emph  {Full temporal trajectories under weak coupling versus strong coupling.} Time series illustrate intervention onset (step 300) and withdrawal (step 1500) for two representative cases: one with no coupling (\(\alpha _{DP} = 0\)) and one with strong coupling (\(\alpha _{DP} = 0.65\)). Depression responds more gradually and persistently under strong coupling, whereas precariousness adjusts more quickly.}}{23}{figure.caption.11}\protected@file@percent }
\newlabel{fig-intervention}{{8}{23}{\textbf {\emph {System response to external intervention across variations in internal structure.}} \textbf {(A)} \emph {Mean levels of depression (\(D\)) and precariousness (\(P\)) at key time points.} At time steps 100, 300, and 500, we compare models that differ in the coupling coefficient \(\alpha _{DP}\), which represents the strength of depression's influence on precariousness in the dynamical model. The x‑axis shows intervention strength, defined as the proportional reduction of financial stress (\(S\)) relative to its baseline (with higher values indicating more external financial support). Each line corresponds to a different model, color-coded from weak (purple) to strong (yellow) coupling. Models with weaker coupling exhibit faster early reductions in \(D\), while stronger coupling shifts the response toward \(P\), producing more immediate declines in precariousness. \textbf {(B)} \emph {Full temporal trajectories under weak coupling versus strong coupling.} Time series illustrate intervention onset (step 300) and withdrawal (step 1500) for two representative cases: one with no coupling (\(\alpha _{DP} = 0\)) and one with strong coupling (\(\alpha _{DP} = 0.65\)). Depression responds more gradually and persistently under strong coupling, whereas precariousness adjusts more quickly}{figure.caption.11}{}}
