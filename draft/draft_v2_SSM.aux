\BKM@entry{id=8,dest={73756273756273656374696F6E2E322E332E32},srcline={855}}{5C3337365C3337375C303030495C3030306E5C303030745C303030655C303030725C303030765C303030655C3030306E5C303030745C303030695C3030306F5C3030306E5C3030305C3034305C303030535C303030695C3030306D5C303030755C3030306C5C303030615C303030745C303030695C3030306F5C3030306E}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {\emph  {High-level schematic of the dynamic model structure used in simulation.}} Arrows represent influence coefficients \(\alpha \), matching the terms in the system of stochastic differential equations. \(D_i(t)\) and \(P_i(t)\) denote depressive symptoms and social precariousness for individual \(i\), with \(S_i\) representing static financial stress. Financial stress acts as an upstream driver of depressive symptoms and social precariousness, pushing both up. Depression and precariousness influence each other bidirectionally, forming a reinforcing feedback loop. Arrows depict influence pathways that are operationalized in our quantitative model. This abstraction summarizes dependencies identified by causal discovery and anchors our intervention experiments.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig-concept}{{3}{10}{\textbf {\emph {High-level schematic of the dynamic model structure used in simulation.}} Arrows represent influence coefficients \(\alpha \), matching the terms in the system of stochastic differential equations. \(D_i(t)\) and \(P_i(t)\) denote depressive symptoms and social precariousness for individual \(i\), with \(S_i\) representing static financial stress. Financial stress acts as an upstream driver of depressive symptoms and social precariousness, pushing both up. Depression and precariousness influence each other bidirectionally, forming a reinforcing feedback loop. Arrows depict influence pathways that are operationalized in our quantitative model. This abstraction summarizes dependencies identified by causal discovery and anchors our intervention experiments}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {\emph  {Trade-off curves showing how calibrated parameters vary with coupling strength.}} Each line tracks how a model parameter changes with the coupling coefficient (\(\alpha _{DP}\)), which quantifies the influence of precariousness on depression in the dynamical model. These adjustments preserve consistency with empirical covariances from the HELIUS data. Together, the curves illustrate that multiple internal configurations are equally compatible with the data, highlighting how system dynamics can reorganize as coupling strength varies.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig-tradeoff}{{4}{11}{\textbf {\emph {Trade-off curves showing how calibrated parameters vary with coupling strength.}} Each line tracks how a model parameter changes with the coupling coefficient (\(\alpha _{DP}\)), which quantifies the influence of precariousness on depression in the dynamical model. These adjustments preserve consistency with empirical covariances from the HELIUS data. Together, the curves illustrate that multiple internal configurations are equally compatible with the data, highlighting how system dynamics can reorganize as coupling strength varies}{figure.caption.5}{}}
